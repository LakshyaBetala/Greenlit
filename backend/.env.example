# ===========================================
# Greenlit Backend — Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual keys.
# Run: copy .env.example .env
#
# Variables are grouped by sprint. Only Sprint 1 keys are needed today.
# Future-sprint placeholders are pre-scaffolded so we don't have to
# re-edit this file every sprint.

# =============================================================
# SPRINT 1 — Required to run locally TODAY
# =============================================================

# ------ GitHub OAuth App (REQUIRED for login) ------
# Create at: https://github.com/settings/developers
# Callback URL (dev):  http://localhost:8000/auth/github/callback
# Callback URL (prod): https://api.greenlit.dev/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ------ Session Signing (REQUIRED) ------
# Use: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET="change-me-to-a-random-string"

# ------ Gemini API (REQUIRED for RAG Analysis) ------
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ------ GitHub Token (OPTIONAL until Sprint 5 — for Auto-Fix PR creation) ------
# If left empty, Auto-Fix will run in Simulation Mode.
GITHUB_TOKEN=""

# ------ Server Configuration ------
PORT=8000
HOST="0.0.0.0"

# Comma-separated extra origins allowed by CORS (dev origins always included)
# Example: ALLOWED_ORIGINS="https://greenlit.dev,https://www.greenlit.dev"
ALLOWED_ORIGINS=""

# Override default SQLite path (default: .storage/greenlit.db next to repo root)
# DATABASE_PATH="/data/greenlit.db"

# =============================================================
# SPRINT 2 — Persistence (Redis + Supabase)
# =============================================================

# Upstash Redis — free tier, used for job queue + commit-SHA cache
# Sign up: https://upstash.com → Create Redis → Copy REST URL
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# Supabase Postgres — free tier, used for users/repos/audits/fixes
# Sign up: https://supabase.com → New project → Settings → API
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================
# SPRINT 4 — GitHub App (replaces OAuth-only flow for webhooks)
# =============================================================

# Create at: https://github.com/settings/apps → New GitHub App
# Permissions: Contents (R/W), Pull requests (W), Metadata (R)
# Webhook URL: https://api.greenlit.dev/webhooks/github
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""   # paste the full PEM contents (one line, \n preserved)
GITHUB_APP_WEBHOOK_SECRET="" # random string used to verify webhooks
GITHUB_APP_INSTALLATION_ID="" # populated per-user, not at startup

# =============================================================
# SPRINT 1 (v2) — Anthropic Claude (PRIMARY model — deep + tick passes)
# =============================================================
# Sonnet 4.6 powers deep scans (first audit, vuln descriptions, autofix
# diffs). Haiku 4.5 powers monitoring ticks + Bot pre-screens. Gemini
# becomes the fallback chain when Anthropic fails.
#
# Get a key: https://console.anthropic.com
# Without this key, all LLM calls fall back to the Gemini chain
# (works, but findings will be less sharp). Required for v2 quality bar.
ANTHROPIC_API_KEY=""

# =============================================================
# SPRINT 7 — Payments (geo-split: Stripe US/EU, Razorpay India)
# =============================================================

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""    # price_xxx for $7/mo Starter
STRIPE_PRICE_BUILDER=""    # price_xxx for $29/mo Builder

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_PLAN_STARTER=""   # plan_xxx for ₹299/mo
RAZORPAY_PLAN_BUILDER=""   # plan_xxx for ₹999/mo

# =============================================================
# SPRINT 8 — Cloudflare R2 for report blob storage
# =============================================================

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="greenlit-reports"
R2_PUBLIC_URL=""           # e.g. https://reports.greenlit.dev

# =============================================================
# SPRINT 10 — Email (Resend)
# =============================================================

RESEND_API_KEY=""
RESEND_FROM_EMAIL="alerts@greenlit.dev"

# =============================================================
# SPRINT 11 — Analytics (PostHog) + Errors (Sentry)
# =============================================================

POSTHOG_API_KEY=""
SENTRY_DSN=""

# =============================================================
# OPTIONAL — Cross-cutting flags
# =============================================================

# Set to "production" on Oracle Cloud, leave empty for local dev
ENVIRONMENT="development"

# Public URL for the frontend (used in OAuth callbacks, emails, badges)
FRONTEND_URL="http://localhost:3000"

# Public URL for the backend (used in webhook URLs, email links)
BACKEND_URL="http://localhost:8000"
